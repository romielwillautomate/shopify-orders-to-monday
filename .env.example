# Shopify signing secret. Webhooks made in the Shopify admin (Settings → Notifications → Webhooks):
# the key shown under "Your webhooks will be signed with". Webhooks of an app: the app's client secret.
# Until this is set, every webhook is refused with a 401 and an alert.
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-signing-secret

# monday.com personal API token (profile picture → Developers → API token → Show)
MONDAY_API_TOKEN=your-monday-api-token
# The number in the board URL: https://yourcompany.monday.com/boards/1234567890
MONDAY_BOARD_ID=1234567890
# Optional: the group new orders go into. Leave empty for the board's top group.
MONDAY_GROUP_ID=
# Optional, default 2026-07 (monday's current stable API version)
MONDAY_API_VERSION=2026-07

# Column IDs on your board (turn on Developer mode in monday.labs to see them). Leave a key out to skip that column.
# order_number is required. shopify_updated_at and flags are strongly recommended (late updates, one alert per flag).
MONDAY_COLUMNS={"order_number":"text_mkx1ordr","customer":"text_mkx1cust","email":"email_mkx1mail","total":"numeric_mkx1totl","payment_status":"color_mkx1paym","fulfillment_status":"color_mkx1fulf","shipping_method":"text_mkx1ship","order_date":"date_mkx1ordd","flags":"dropdown_mkx1flag","shopify_updated_at":"text_mkx1upd8"}
# Column IDs on the subitems board (open a subitem column's menu to see them)
MONDAY_SUBITEM_COLUMNS={"sku":"text_mkx2sku0","quantity":"numeric_mkx2qty0"}

# Optional: how patient the workflow is with monday rate limits (defaults 4 attempts, wait at most 60 seconds)
MONDAY_MAX_ATTEMPTS=4
MONDAY_MAX_WAIT_SECONDS=60

# Flags. An order is VIP when its total is at or above this amount (shop currency). 0 turns VIP off.
VIP_ORDER_TOTAL=500
# An order is rush when a shipping method contains one of these words (whole words, any case). Empty turns rush off.
RUSH_SHIPPING_KEYWORDS=express,overnight,next day,priority,rush

# Optional: Slack incoming webhook for VIP and rush alerts and error alerts. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
